/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' mailto:; img-src 'self' data: blob: https://images.unsplash.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self' data:; frame-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
/index.html
  Cache-Control: no-cache
/*.css
  Cache-Control: no-cache
/*.js
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
